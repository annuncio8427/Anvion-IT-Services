# ==========================================
# ANVION IT SERVICES - Environment Configuration
# ==========================================

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Initial Super Administrator Provisioning
# The server will bootstrap this admin account if not already present.
INITIAL_ADMIN_EMAIL=annuncio8427@gmail.com
INITIAL_ADMIN_PASSWORD=Annuncio@08

# Legacy / Backend Administrator JWT Secret
# Set a unique random string (at least 32 characters) for signing admin session tokens.
ADMIN_JWT_SECRET=anvion_production_jwt_secret_key_2026_secure

# Firebase Configuration
# Set the target Firebase Project ID (e.g., anvion-it-services-production or pure-formula-xxjsq)
FIREBASE_PROJECT_ID=anvion-it-services-production

# Firebase Admin SDK Service Account Key
# Provide the complete JSON service account credentials as a single-line JSON string or path to .json file:
# Example: {"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}
FIREBASE_SERVICE_ACCOUNT_KEY=

# PostgreSQL Database (Optional for Cloud persistence)
SQL_HOST=
SQL_PORT=5432
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

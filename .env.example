# Server
PORT=3000
HOST=0.0.0.0

# PostgreSQL database
SQL_HOST=
SQL_PORT=5432
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Authentication & Admin
# Generate a unique random secret with at least 32 characters for legacy admin JWT login.
ADMIN_JWT_SECRET=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Firebase Admin SDK
# Optional when the hosting platform provides Application Default Credentials.
# Otherwise provide the service-account JSON as a single-line JSON string.
FIREBASE_SERVICE_ACCOUNT_KEY=

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Authorized Admin Check (Authoritative Custom Claim + Trusted Admin Collection Fallback)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'ADMIN'
        )
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ==========================================
    // 2. USERS COLLECTION (/users/{userId})
    // ==========================================
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      
      // Prevent Self-Assigned Roles: New signups MUST have role == 'USER'
      allow create: if isValidId(userId) && isOwner(userId) &&
        incoming().role == 'USER' &&
        incoming().email is string &&
        incoming().email.size() <= 150 &&
        incoming().name is string &&
        incoming().name.size() <= 100;

      // Normal users may update only name, phone and updatedAt. Never allow modifying role or UID!
      allow update: if isValidId(userId) && (
        (isOwner(userId) &&
         incoming().role == existing().role &&
         incoming().uid == existing().uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'updatedAt'])) ||
        isAdmin()
      );

      allow delete: if isValidId(userId) && isAdmin();
    }

    // ==========================================
    // 3. ADMINS WHITELIST (/admins/{adminId})
    // ==========================================
    match /admins/{adminId} {
      allow read, write: if isValidId(adminId) && isAdmin();
    }

    // ==========================================
    // 4. CLIENTS COLLECTION (/clients/{clientId})
    // ==========================================
    match /clients/{clientId} {
      allow get: if isValidId(clientId) && (isOwner(clientId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(clientId) && (isOwner(clientId) || isAdmin());
      allow update: if isValidId(clientId) && (
        (isOwner(clientId) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'companyName', 'address', 'website', 'profileImage', 'updatedAt'])) ||
        isAdmin()
      );
      allow delete: if isValidId(clientId) && isAdmin();
    }

    // ==========================================
    // 5. LEADS / CRM (/leads/{leadId})
    // ==========================================
    match /leads/{leadId} {
      allow create: if isValidId(leadId) && incoming().name is string && incoming().email is string;
      allow get, list, update, delete: if isValidId(leadId) && isAdmin();
    }

    // ==========================================
    // 6. TASKS & MILESTONES (/tasks/{taskId})
    // ==========================================
    match /tasks/{taskId} {
      allow get: if isValidId(taskId) && (
        isAdmin() ||
        (isSignedIn() && existing().get('isClientVisible', false) == true && (existing().get('clientId', '') == request.auth.uid || existing().get('clientEmail', '') == request.auth.token.email))
      );
      allow list: if isAdmin() || (
        isSignedIn() && resource.data.get('isClientVisible', false) == true && (resource.data.get('clientId', '') == request.auth.uid || resource.data.get('clientEmail', '') == request.auth.token.email)
      );
      allow create, update, delete: if isValidId(taskId) && isAdmin();
    }

    match /projectMilestones/{milestoneId} {
      allow get: if isValidId(milestoneId) && (
        isAdmin() ||
        (isSignedIn() && (existing().get('clientId', '') == request.auth.uid || existing().get('clientEmail', '') == request.auth.token.email))
      );
      allow list: if isAdmin() || (
        isSignedIn() && (resource.data.get('clientId', '') == request.auth.uid || resource.data.get('clientEmail', '') == request.auth.token.email)
      );
      allow create, update, delete: if isValidId(milestoneId) && isAdmin();
    }

    // ==========================================
    // 7. INVOICES (/invoices/{invoiceId})
    // ==========================================
    match /invoices/{invoiceId} {
      allow get: if isValidId(invoiceId) && (
        isAdmin() ||
        (isSignedIn() && (existing().get('clientId', '') == request.auth.uid || existing().get('clientEmail', '') == request.auth.token.email))
      );
      allow list: if isAdmin() || (
        isSignedIn() && (resource.data.get('clientId', '') == request.auth.uid || resource.data.get('clientEmail', '') == request.auth.token.email)
      );
      allow create, update, delete: if isValidId(invoiceId) && isAdmin();
    }

    // ==========================================
    // 8. PAYMENTS (/payments/{paymentId})
    // ==========================================
    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && (
        isAdmin() ||
        (isSignedIn() && (existing().get('clientId', '') == request.auth.uid || existing().get('clientEmail', '') == request.auth.token.email))
      );
      allow list: if isAdmin() || (
        isSignedIn() && (resource.data.get('clientId', '') == request.auth.uid || resource.data.get('clientEmail', '') == request.auth.token.email)
      );
      allow create: if isValidId(paymentId) && (isAdmin() || (isSignedIn() && incoming().get('clientId', '') == request.auth.uid));
      allow update, delete: if isValidId(paymentId) && isAdmin();
    }

    // ==========================================
    // 9. SUPPORT TICKETS & MESSAGES
    // ==========================================
    match /supportTickets/{ticketId} {
      allow get: if isValidId(ticketId) && (
        isAdmin() ||
        (isSignedIn() && (existing().get('clientId', '') == request.auth.uid || existing().get('clientEmail', '') == request.auth.token.email))
      );
      allow list: if isAdmin() || (
        isSignedIn() && (resource.data.get('clientId', '') == request.auth.uid || resource.data.get('clientEmail', '') == request.auth.token.email)
      );
      allow create: if isValidId(ticketId) && (
        isAdmin() ||
        (isSignedIn() && (incoming().get('clientId', '') == request.auth.uid || incoming().get('clientEmail', '') == request.auth.token.email))
      );
      allow update: if isValidId(ticketId) && (
        isAdmin() ||
        (isSignedIn() && (existing().get('clientId', '') == request.auth.uid || existing().get('clientEmail', '') == request.auth.token.email))
      );
      allow delete: if isValidId(ticketId) && isAdmin();
    }

    match /supportMessages/{messageId} {
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        (resource.data.get('clientId', '') == request.auth.uid || resource.data.get('clientEmail', '') == request.auth.token.email)
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        (incoming().get('clientId', '') == request.auth.uid || incoming().get('clientEmail', '') == request.auth.token.email)
      );
      allow update, delete: if isValidId(messageId) && isAdmin();
    }

    // ==========================================
    // 10. NOTIFICATIONS (/notifications/{notificationId})
    // ==========================================
    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && (
        isAdmin() ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('email', '') == request.auth.token.email
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (existing().get('userId', '') == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt']))
      );
      allow create, delete: if isValidId(notificationId) && isAdmin();
    }

    // ==========================================
    // 11. STAFF & SETTINGS
    // ==========================================
    match /staff/{staffId} {
      allow read, write: if isValidId(staffId) && isAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if isValidId(settingId) && isAdmin();
    }

    // ==========================================
    // 12. PROJECT ENQUIRIES (/projectEnquiries/{enquiryId})
    // ==========================================
    match /projectEnquiries/{enquiryId} {
      allow create: if isValidId(enquiryId) &&
        incoming().name is string && incoming().name.size() <= 120 &&
        incoming().email is string && incoming().email.size() <= 150 &&
        incoming().description is string && incoming().description.size() <= 5000 &&
        (!isSignedIn() || incoming().get('userId', '') == request.auth.uid || incoming().get('userId', '') == null);

      allow get: if isValidId(enquiryId) && (
        (isSignedIn() && existing().get('userId', '') == request.auth.uid) ||
        isAdmin()
      );

      allow list: if (isSignedIn() && existing().get('userId', '') == request.auth.uid) || isAdmin();
      allow update: if isValidId(enquiryId) && isAdmin();
      allow delete: if isValidId(enquiryId) && isAdmin();
    }

    // ==========================================
    // 13. CONTACT MESSAGES (/contactMessages/{messageId})
    // ==========================================
    match /contactMessages/{messageId} {
      allow create: if isValidId(messageId) &&
        incoming().name is string && incoming().name.size() <= 120 &&
        incoming().email is string && incoming().email.size() <= 150 &&
        incoming().message is string && incoming().message.size() <= 3000;

      allow get: if isValidId(messageId) && isAdmin();
      allow list: if isAdmin();
      allow update: if isValidId(messageId) && isAdmin();
      allow delete: if isValidId(messageId) && isAdmin();
    }

    // ==========================================
    // 14. PROJECTS & CASE STUDIES (/projects/{projectId})
    // ==========================================
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (
        existing().get('published', false) == true ||
        existing().get('published', '') == 'true' ||
        (isSignedIn() && (existing().get('clientId', '') == request.auth.uid || existing().get('clientEmail', '') == request.auth.token.email)) ||
        isAdmin()
      );

      allow list: if existing().get('published', false) == true ||
                     existing().get('published', '') == 'true' ||
                     (isSignedIn() && (resource.data.get('clientId', '') == request.auth.uid || resource.data.get('clientEmail', '') == request.auth.token.email)) ||
                     isAdmin();

      allow create, update, delete: if isValidId(projectId) && isAdmin();
    }

    // ==========================================
    // 15. SERVICES (/services/{serviceId})
    // ==========================================
    match /services/{serviceId} {
      allow get: if isValidId(serviceId) && (
        existing().get('published', false) == true ||
        existing().get('published', '') == 'true' ||
        isAdmin()
      );

      allow list: if existing().get('published', false) == true ||
                     existing().get('published', '') == 'true' ||
                     isAdmin();

      allow create, update, delete: if isValidId(serviceId) && isAdmin();
    }

    // ==========================================
    // 16. REVIEWS / TESTIMONIALS (/reviews/{reviewId})
    // ==========================================
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (
        existing().get('published', false) == true ||
        existing().get('published', '') == 'true' ||
        isAdmin()
      );

      allow list: if existing().get('published', false) == true ||
                     existing().get('published', '') == 'true' ||
                     isAdmin();

      allow create, update, delete: if isValidId(reviewId) && isAdmin();
    }

    // ==========================================
    // 17. BLOG POSTS (/blogPosts/{postId})
    // ==========================================
    match /blogPosts/{postId} {
      allow get: if isValidId(postId) && (
        existing().get('published', false) == true ||
        existing().get('published', '') == 'true' ||
        isAdmin()
      );

      allow list: if existing().get('published', false) == true ||
                     existing().get('published', '') == 'true' ||
                     isAdmin();

      allow create, update, delete: if isValidId(postId) && isAdmin();
    }

    // ==========================================
    // 18. CAREERS / JOBS (/jobs/{jobId})
    // ==========================================
    match /jobs/{jobId} {
      allow get: if isValidId(jobId) && (
        existing().get('published', false) == true ||
        existing().get('published', '') == 'true' ||
        isAdmin()
      );

      allow list: if existing().get('published', false) == true ||
                     existing().get('published', '') == 'true' ||
                     isAdmin();

      allow create, update, delete: if isValidId(jobId) && isAdmin();
    }

    // ==========================================
    // 19. JOB APPLICATIONS (/jobApplications/{applicationId})
    // ==========================================
    match /jobApplications/{applicationId} {
      allow create: if isValidId(applicationId) &&
        incoming().name is string && incoming().name.size() <= 120 &&
        incoming().email is string && incoming().email.size() <= 150;

      allow get: if isValidId(applicationId) && isAdmin();
      allow list: if isAdmin();
      allow update: if isValidId(applicationId) && isAdmin();
      allow delete: if isValidId(applicationId) && isAdmin();
    }

    // ==========================================
    // 20. FAQS (/faqs/{faqId})
    // ==========================================
    match /faqs/{faqId} {
      allow get: if isValidId(faqId) && (
        existing().get('published', false) == true ||
        existing().get('published', '') == 'true' ||
        isAdmin()
      );

      allow list: if existing().get('published', false) == true ||
                     existing().get('published', '') == 'true' ||
                     isAdmin();

      allow create, update, delete: if isValidId(faqId) && isAdmin();
    }

    // ==========================================
    // 21. WEBSITE CONTENT (/websiteContent/{contentId})
    // ==========================================
    match /websiteContent/{contentId} {
      allow get: if isValidId(contentId);
      allow list: if true;
      allow create, update, delete: if isValidId(contentId) && isAdmin();
    }

    // ==========================================
    // 22. ADMIN AUDIT LOGS (/adminAuditLogs/{logId})
    // ==========================================
    match /adminAuditLogs/{logId} {
      allow create: if isValidId(logId) && isAdmin();
      allow get, list: if isAdmin();
      // Immutable audit log: No updates or deletions ever permitted
      allow update, delete: if false;
    }
  }
}
